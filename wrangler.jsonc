{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lux-player-zero",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/cinema", "/cinema/*", "/cinema.html", "/player.html", "/account", "/account/*", "/account.html", "/guide/*"]
  },
  "triggers": { "crons": ["0 6 * * *", "0 7 * * *", "* * * * *"] },
  "observability": { "enabled": true }
}
