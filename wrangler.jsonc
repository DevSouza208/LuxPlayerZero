{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lux-player-zero",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/cinema", "/cinema/*", "/cinema.html", "/player.html", "/account", "/account/*", "/account.html", "/guide/*"]
  },
  "triggers": { "crons": ["0 8 * * *", "* * * * *"] },
  "ratelimits": [
    {"name":"ACCOUNT_REQUEST_LIMIT","namespace_id":"2201","simple":{"limit":120,"period":60}},
    {"name":"PROFILE_SYNC_LIMIT","namespace_id":"2202","simple":{"limit":30,"period":60}},
    {"name":"METADATA_REQUEST_LIMIT","namespace_id":"2203","simple":{"limit":600,"period":60}}
  ],
  "observability": { "enabled": true }
}
